# Auto-detect text files and normalize line endings
* text=auto

# Python
*.py text diff=python
*.pyw text
*.pyx text
*.pxd text

# Shell scripts
*.ps1 text eol=crlf
*.sh text eol=lf

# Markdown and docs
*.md text diff=markdown
*.rst text
*.txt text

# Config files
*.json text
*.toml text
*.yaml text
*.yml text
*.cfg text
*.ini text
*.conf text

# Git files
.gitattributes text
.gitignore text
.gitmodules text

# Keep binary files as-is
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg -text
*.woff binary
*.woff2 binary
*.eot binary
*.ttf binary

# Lock files should be treated as binary
*.lock binary
